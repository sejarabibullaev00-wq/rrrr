

IF OBJECT_ID('dbo.Employees', 'U') IS NOT NULL
    DROP TABLE dbo.Employees;

CREATE TABLE dbo.Employees (
    EmployeeID INT IDENTITY(1,1) NOT NULL PRIMARY KEY, -- Автоинкремент, первичный ключ
    FirstName NVARCHAR(50) NOT NULL,                   -- Имя (обязательное поле)
    LastName NVARCHAR(50) NOT NULL,                    -- Фамилия (обязательное поле)
    Position NVARCHAR(100) NULL,                       -- Должность (может быть NULL)
    Salary DECIMAL(18,2) NOT NULL,                     -- Зарплата (точное число)
    HireDate DATE NOT NULL                             -- Дата найма
);

PRINT 'Таблица dbo.Employees успешно создана.';
